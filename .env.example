# ===== AutoPrint RaceFacer - configuration =====
# Copie ce fichier en ".env" et remplis les valeurs.

# --- RaceFacer ---
# Domaine de ton instance RaceFacer (sans slash final).
RF_BASE_URL=https://racefacer.brossard.goplex.ca

# Le sub_track_id de la piste a surveiller (visible dans les URLs ajax du HAR).
RF_SUB_TRACK_ID=1

# Cookie de session RaceFacer.
# Les endpoints /ajax/... ET la page d'impression sont proteges par le cookie
# de session de l'admin deja connecte dans le navigateur. Pour le recuperer :
#   1. Ouvre RaceFacer dans Chrome, connecte-toi comme d'habitude.
#   2. F12 -> onglet "Network" -> clique une requete vers /ajax/session-management/...
#   3. Section "Request Headers" -> copie TOUTE la valeur de "cookie:" ici.
# (Astuce : "npm run discover" peut recuperer ce cookie automatiquement.)
RF_COOKIE=

# --- Page d'impression RaceFacer ---
# URL de la page qui affiche la feuille de resultats a imprimer (celle du PDF).
# On NE reconstruit PAS la feuille : on ouvre CETTE page dans Chromium et on
# l'imprime telle quelle. Placeholders disponibles :
#   {race_uuid}  -> uuid de l'evenement course
#   {id}         -> id numerique du heat
#   {uuid}       -> uuid du heat
#   {race_stage_id}, {race_id}, {sub_track_id}
# URL trouvee via `npm run discover` pour cette instance (motif RaceFacer) :
RF_PRINT_URL=https://racefacer.brossard.goplex.ca/fr/administration/races/race/{race_uuid}/print-results/{id}

# --- Filtre : quelles courses imprimer ---
# On imprime uniquement les "race_heat" (courses de competition), jamais les
# "session" libres. Options facultatives pour affiner :
# Motif (regex, insensible a la casse) sur le race_label. Vide = toutes.
RF_RACE_LABEL_MATCH=
# Motif (regex) sur le stage_label (PRATIQUE, FINALE, ...). Vide = tous.
RF_STAGE_MATCH=
# N'imprimer que quand les resultats sont confirmes cote RaceFacer (recommande).
RF_REQUIRE_CONFIRMED=true

# --- Boucle de polling ---
# Intervalle entre deux verifications du calendrier, en secondes.
POLL_INTERVAL_SECONDS=20
# Date a surveiller : "today" (defaut, date locale) ou une date fixe YYYY-MM-DD.
RF_DATE=today

# --- Chromium / impression ---
# Chemin de l'executable Chrome/Chromium/Edge. Vide = auto-detection.
CHROME_PATH=

# Reglages de la page imprimee (appliques au rendu PDF) :
# Taille du papier : Letter, A4, Legal, ...
PAPER_SIZE=Letter
# Graphiques d'arriere-plan (couleurs/fonds). true = coche.
PRINT_BACKGROUND=true
# En-tetes et pieds de page (date, titre, URL, numero de page). true = coche.
PRINT_HEADER_FOOTER=true
# Marges : "default" (comme Chrome), "none", ou une valeur CSS (ex. 10mm).
PRINT_MARGIN=default
# Mise a l'echelle : 1 = par defaut (100%). Ex. 0.9 pour reduire un peu.
PRINT_SCALE=1

# Mode d'envoi du PDF a l'imprimante :
#   auto    -> detecte l'OS (Windows: PowerShell/SumatraPDF ; Linux/mac: lp)
#   sumatra -> SumatraPDF (Windows, silencieux) - voir SUMATRA_PATH
#   lp      -> commande "lp" (Linux/mac/CUPS)
#   command -> commande custom PRINT_COMMAND ({file} = chemin du PDF)
#   none    -> genere seulement le PDF dans OUTPUT_DIR, sans imprimer
PRINT_MODE=auto

# Nom de l'imprimante. Vide = imprimante par defaut du systeme.
PRINTER_NAME=

# Chemin de SumatraPDF.exe (recommande sur Windows pour un print 100% silencieux).
SUMATRA_PATH=C:\\Program Files\\SumatraPDF\\SumatraPDF.exe

# Commande custom (PRINT_MODE=command). {file} = chemin du PDF, {printer} = PRINTER_NAME.
PRINT_COMMAND=

# Nombre de copies a imprimer par course.
PRINT_COPIES=1

# Dossier ou sont ecrits les PDF generes (archive + impression).
OUTPUT_DIR=./output

# --- Etat / anti-doublon ---
# Fichier ou on memorise les heats deja imprimees (pour ne jamais imprimer 2x).
STATE_FILE=./state/printed.json
